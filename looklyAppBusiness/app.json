{
  "expo": {
    "name": "Business",
    "slug": "looklyAppBusiness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo_negro.png",
    "scheme": "looklyappbusiness",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cris9310.looklyAppBusiness",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "transparent",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.cris9310.looklyAppBusiness"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/minilogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo_negro.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "transparent",
          "dark": {
            "backgroundColor": "transparent"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43835446-769e-4c39-9651-5b124e75b173"
      }
    }
  }
}
